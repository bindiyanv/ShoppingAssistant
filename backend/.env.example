# --- LLM provider for chat: "gemini" or "groq" ---
LLM_PROVIDER=gemini

# Gemini (https://aistudio.google.com/apikey) — required: embeddings always use Gemini
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768

# Groq (https://console.groq.com/keys) — only needed if LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-20b

# Storage (paths relative to backend/)
DATABASE_URL=sqlite:///./shopassist.db
CHROMA_PATH=./chroma_data
CHROMA_COLLECTION=products

# RAG
TOP_K=5
HISTORY_TURNS=6
CORS_ORIGINS=http://localhost:5173
